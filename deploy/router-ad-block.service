[Unit]
Description=Router Ad Block (DNS ad blocker)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/router-ad-block
ExecStart=/opt/router-ad-block/.venv/bin/python -m adblock
Environment=DATA_DIR=/var/lib/router-ad-block
Environment=ADMIN_PASSWORD=change-me
Restart=on-failure
# Bind port 53 without running as root.
DynamicUser=yes
StateDirectory=router-ad-block
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
